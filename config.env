CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/fengjunjiejunjie-web/android_kernel_samsung_sm7325
KERNEL_SOURCE_BRANCH=lineage-22.1
KERNEL_CONFIG=vendor/lineage-gts7fewifi_defconfig

ARCH=arm64

KERNEL_IMAGE_NAME=Image.gz-dtb

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false


# ================================================================= Compiler ==

#
# Linux 5.4 Samsung SM7325
#

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

#
# Do not force LLVM=1 yet.
#
USE_LLVM=false


# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# =============================================================== Compiler ==

#
# IMPORTANT:
# Do NOT use:
#
# EXTRA_CMDS:LD=ld.lld
#
# Use normal KEY=value syntax.
#

EXTRA_CMDS="KCFLAGS=-Wno-error=strict-prototypes"

CUSTOM_CMDS="CLANG_TRIPLE=aarch64-linux-gnu-"


# =============================================================== KernelSU ===

KSU_VARIANT=resukisu
KSU_REF=main

#
# 5.4 is new enough for kprobes-based KernelSU hooks.
#
KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=


# ================================================================= SUSFS ===

#
# Initially disable SUSFS.
# First make KernelSU + kernel compile successfully.
#

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto


# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=false

ENABLE_HIDE_STUFF=false

ENABLE_KPM=false


# ================================================================ Kconfig ===

#
# 5.4 supports KPROBES and KernelSU can use them.
#

ADD_KPROBES_CONFIG=true

ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG="CONFIG_SECTION_MISMATCH_WARN_ONLY=y"


# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================== Packaging ===

NEED_DTBO=false

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=


# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
